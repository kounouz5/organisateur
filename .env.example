# L'application est 100 % GRATUITE tant que ANTHROPIC_API_KEY reste vide :
# parseur par règles + assistant hors-ligne, rien n'est envoyé sur Internet.
#
# Optionnel et PAYANT : avec une clé, Claude comprend des phrases plus libres
# et l'assistant discute plus naturellement (facturé à l'usage par Anthropic).
ANTHROPIC_API_KEY=

# IA locale GRATUITE (expérimental, désactivée par défaut) : installe Ollama (https://ollama.com),
# télécharge un modèle qui gère les appels d'outils, puis écris son nom ci-dessous.
# Sur un PC sans carte graphique, certains modèles mettent plusieurs minutes à répondre :
# l'assistant abandonne au bout de 20 secondes et répond alors en mode rapide (règles).
# Laisse vide pour garder le mode rapide.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434

# Optionnel : boîte mail (sinon, connecte-la depuis la section « Mails » de l'app).
# MAIL_PASSWORD = un « mot de passe d'application », pas ton mot de passe habituel.
MAIL_ADDRESS=
MAIL_PASSWORD=
MAIL_IMAP_HOST=
LLM_MODEL=claude-haiku-5-5
ASSISTANT_MODEL=claude-opus-5-5
